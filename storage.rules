rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile spec images
    match /profiles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Real photo submissions — public read so CachedNetworkImage works
    match /sheet_photos/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Report corrections
    match /corrections/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Admin uploads
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
