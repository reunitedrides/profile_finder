rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile spec images — public read
    match /profiles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Real photo submissions from users
    match /sheet_photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Report corrections (with optional photo)
    match /corrections/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin uploads
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
